\ProvidesPackage{cv-style}[2026/08/16 Semantic academic CV style]

\RequirePackage[letterpaper,left=0.78in,right=0.78in,top=0.75in,bottom=0.72in]{geometry}
\RequirePackage{fontspec}
\defaultfontfeatures{Ligatures=TeX,Scale=MatchLowercase}
\setmainfont{Times New Roman}
\RequirePackage{microtype}
\RequirePackage{xcolor}
\RequirePackage{hyperref}
\RequirePackage{bookmark}
\RequirePackage{fancyhdr}
\RequirePackage{needspace}
\RequirePackage{enumitem}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{etoolbox}
\RequirePackage{csquotes}

\definecolor{cvaccent}{HTML}{243447}
\hypersetup{
  colorlinks=true,
  urlcolor=cvaccent,
  linkcolor=cvaccent,
  citecolor=cvaccent,
  pdfauthor={Nathan I. Wisnoski},
  pdftitle={Nathan I. Wisnoski -- Curriculum Vitae}
}
\urlstyle{same}

\setlength{\parindent}{0pt}
\setlength{\parskip}{0.20em}
\setlength{\emergencystretch}{2em}
\widowpenalty=10000
\clubpenalty=10000
\displaywidowpenalty=10000

\providecommand{\CVName}{Nathan I. Wisnoski}
\providecommand{\CVUpdated}{August 2026}

\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\footnotesize \CVName}
\fancyhead[R]{\footnotesize Curriculum Vitae}
\fancyfoot[L]{\footnotesize Updated \CVUpdated}
\fancyfoot[R]{\footnotesize \thepage}
\renewcommand{\headrulewidth}{0.35pt}
\renewcommand{\footrulewidth}{0pt}
\fancypagestyle{firstpage}{
  \fancyhf{}
  \fancyfoot[L]{\footnotesize Updated \CVUpdated}
  \fancyfoot[R]{\footnotesize \thepage}
  \renewcommand{\headrulewidth}{0pt}
}
\fancypagestyle{plain}{
  \fancyhf{}
  \fancyhead[L]{\footnotesize \CVName}
  \fancyhead[R]{\footnotesize Curriculum Vitae}
  \fancyfoot[L]{\footnotesize Updated \CVUpdated}
  \fancyfoot[R]{\footnotesize \thepage}
  \renewcommand{\headrulewidth}{0.35pt}
  \renewcommand{\footrulewidth}{0pt}
}
\makeatletter
\let\ps@plain\ps@fancy
\makeatother

\newcommand{\cvheader}[3]{%
  \begin{center}
    {\Huge\normalfont #1}\par
    \vspace{0.25em}
    #2\par
    \vspace{0.15em}
    #3
  \end{center}
  \vspace{0.45em}
}

\newcounter{cvsectioncounter}
\newcommand{\cvsection}[1]{%
  \Needspace{5\baselineskip}%
  \refstepcounter{cvsectioncounter}%
  \vspace{0.8em}%
  \par\noindent{\large\normalfont\MakeUppercase{#1}}\par
  \vspace{0.18em}\hrule height 0.45pt\vspace{0.42em}%
  \pdfbookmark[1]{#1}{cv:section:\arabic{cvsectioncounter}}%
}

\newcommand{\cvsubsection}[1]{%
  \Needspace{3\baselineskip}%
  \par\addvspace{0.45em}\noindent{\normalfont\itshape #1}\par\nobreak\vspace{0.10em}%
}

\newcommand{\cventry}[4]{%
  \Needspace{2.5\baselineskip}%
  \par\noindent\textbf{#1}\hfill #2\par
  \noindent #3\hfill\textit{#4}\par\vspace{0.22em}%
}

\newcommand{\degreeentry}[4]{%
  \Needspace{2.5\baselineskip}%
  \par\noindent\textbf{#1}\hfill #2\par
  \noindent #3\par
  \ifstrempty{#4}{}{\noindent #4\par}%
  \vspace{0.22em}%
}

\newcommand{\datedentry}[2]{%
  \Needspace{2\baselineskip}%
  \par\noindent\hangindent=6.5em\hangafter=1
  \makebox[6.5em][l]{#1}#2\par\vspace{0.08em}%
}

\newcommand{\grantentry}[3]{%
  \par\noindent
  \begin{tabularx}{\linewidth}{@{}>{\raggedright\arraybackslash}p{5.5em}>{\raggedleft\arraybackslash}p{5.3em}X@{}}
    #1 & #2 & #3
  \end{tabularx}\par\vspace{0.1em}%
}

\newcommand{\awardentry}[3]{%
  \Needspace{1.5\baselineskip}%
  \par\noindent #1%
  \ifstrempty{#2}{}{, \textit{#2}}%
  \hfill #3\par
}

\newcommand{\courseentry}[4]{%
  \Needspace{1.5\baselineskip}%
  \par\noindent #1: #2. \textit{#3}. #4.\par
}

\newcommand{\adviseeentry}[3]{%
  \Needspace{1.5\baselineskip}%
  \par\noindent\hangindent=1.5em\hangafter=1%
  \makebox[1.5em][l]{\textbullet}#1\ifstrempty{#2}{}{, \textit{#2}}%
  \ifstrempty{#3}{}{\hfill #3}\par
}

\newcommand{\adviseedatedentry}[2]{%
  \Needspace{1.5\baselineskip}%
  \par\noindent\hangindent=1.5em\hangafter=1%
  \makebox[1.5em][l]{\textbullet}#1%
  \ifstrempty{#2}{}{\space(#2)}\par
}

\newcommand{\cvserviceheading}[1]{%
  \Needspace{5\baselineskip}%
  \par\vspace{0.50em}\noindent{\normalfont\itshape #1}\par\nobreak\vspace{0.08em}%
}

% Service entries share a consistent left-hand label/date gutter while
% remaining ordinary paragraphs that can break naturally across pages.
\newcommand{\servicecolumnentry}[2]{%
  \Needspace{1.5\baselineskip}%
  \par\noindent\hangindent=11em\hangafter=1%
  \makebox[11em][l]{#1}#2\par\vspace{0.12em}%
}

\newcommand{\servicelabelentry}[2]{%
  \servicecolumnentry{\normalfont #1}{#2}%
}

\newcommand{\serviceinstitutionentry}[2]{%
  \servicecolumnentry{\normalfont #1}{#2}%
}

\newcommand{\serviceentry}[1]{%
  \servicecolumnentry{}{#1}%
}

\newcommand{\servicedatedentry}[2]{%
  \servicecolumnentry{#1}{#2}%
}

\newcommand{\cvperiod}{\unskip\ifnum\spacefactor=1000 .\fi}
\newcommand{\talkentry}[5]{%
  \Needspace{5\baselineskip}%
  \par\noindent\hangindent=1.25em\hangafter=1
  #1\cvperiod\space #2\cvperiod\space \textit{#3}\cvperiod\space #4\cvperiod\space #5\cvperiod\par
  \vspace{0.12em}%
}

\setlist[itemize]{%
  leftmargin=1.5em,
  itemsep=0.10em,
  topsep=0.10em,
  parsep=0pt,
  partopsep=0pt
}
